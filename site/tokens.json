{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Betonicum design tokens. Источник истины — site/styles.css (CSS custom properties). Этот файл — машиночитаемое зеркало для инструментов (Figma Tokens, Style Dictionary).",
  "$version": "2.0.0",
  "color": {
    "brand": {
      "primary-900": { "$value": "#0f2238", "$type": "color", "$description": "Футер, оверлеи" },
      "primary-800": { "$value": "#16314f", "$type": "color", "$description": "Основной брендовый navy" },
      "primary-700": { "$value": "#1e4068", "$type": "color", "$description": "Hover, градиенты" },
      "primary-600": { "$value": "#2a5278", "$type": "color" },
      "primary-100": { "$value": "#e7eef6", "$type": "color" },
      "primary-050": { "$value": "#f2f6fb", "$type": "color" }
    },
    "accent": {
      "accent-700": { "$value": "#c2701a", "$type": "color", "$description": "Акцентный текст на светлом" },
      "accent-600": { "$value": "#d97a18", "$type": "color", "$description": "Hover" },
      "accent-500": { "$value": "#f08c26", "$type": "color", "$description": "Основной оранжевый, CTA" },
      "accent-100": { "$value": "#fdeedd", "$type": "color" }
    },
    "neutral": {
      "canvas":   { "$value": "#eef1f5", "$type": "color" },
      "surface":  { "$value": "#ffffff", "$type": "color" },
      "concrete": { "$value": "#dfe5ec", "$type": "color" },
      "ink":      { "$value": "#1c2733", "$type": "color", "$description": "Основной текст" },
      "muted":    { "$value": "#5a6b7d", "$type": "color" },
      "faint":    { "$value": "#8294a6", "$type": "color" },
      "line":     { "$value": "#e1e7ee", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#2e7d32", "$type": "color" },
      "success-100": { "$value": "#e7f4e8", "$type": "color" },
      "info": { "$value": "#1e6fb8", "$type": "color" },
      "info-100": { "$value": "#e6f0f9", "$type": "color" },
      "warning": { "$value": "#f0a226", "$type": "color" },
      "warning-100": { "$value": "#fdf1dd", "$type": "color" },
      "danger": { "$value": "#b03a2e", "$type": "color" },
      "danger-100": { "$value": "#f8e7e4", "$type": "color" }
    }
  },
  "font": {
    "family": { "sans": { "$value": "Manrope, system-ui, sans-serif", "$type": "fontFamily" } },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" },
      "extra": { "$value": 800, "$type": "fontWeight" }
    },
    "size": {
      "display": { "$value": "52px", "$type": "dimension", "$description": "lh 1.08" },
      "h1": { "$value": "40px", "$type": "dimension", "$description": "lh 1.12" },
      "h2": { "$value": "30px", "$type": "dimension", "$description": "lh 1.18" },
      "h3": { "$value": "22px", "$type": "dimension", "$description": "lh 1.25" },
      "lead": { "$value": "18px", "$type": "dimension", "$description": "lh 1.5" },
      "body": { "$value": "16px", "$type": "dimension", "$description": "lh 1.55" },
      "small": { "$value": "14px", "$type": "dimension" },
      "caption": { "$value": "12px", "$type": "dimension", "$description": "overline, uppercase, tracking .14em" }
    }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "24px", "$type": "dimension" },
    "6": { "$value": "32px", "$type": "dimension" },
    "7": { "$value": "48px", "$type": "dimension" },
    "8": { "$value": "64px", "$type": "dimension" },
    "9": { "$value": "96px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "24px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "shadow": {
    "sm": { "$value": "0 1px 3px rgba(15,34,56,.08)", "$type": "shadow" },
    "md": { "$value": "0 4px 14px rgba(15,34,56,.10)", "$type": "shadow" },
    "lg": { "$value": "0 12px 32px rgba(15,34,56,.16)", "$type": "shadow" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "180ms", "$type": "duration" },
      "slow": { "$value": "320ms", "$type": "duration" }
    },
    "easing": {
      "out": { "$value": "cubic-bezier(.2,.7,.3,1)", "$type": "cubicBezier" },
      "in": { "$value": "cubic-bezier(.5,0,.8,.4)", "$type": "cubicBezier" }
    }
  },
  "zIndex": {
    "base": { "$value": 0, "$type": "number" },
    "raised": { "$value": 10, "$type": "number" },
    "sticky": { "$value": 100, "$type": "number" },
    "overlay": { "$value": 800, "$type": "number" },
    "modal": { "$value": 900, "$type": "number" },
    "toast": { "$value": 1000, "$type": "number" }
  },
  "breakpoint": {
    "tablet": { "$value": "992px", "$type": "dimension", "$description": "hero в 1 колонку, меню скрыто" },
    "mobile": { "$value": "560px", "$type": "dimension" }
  }
}
